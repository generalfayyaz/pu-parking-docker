# Copy this file to .env and adjust. NEVER commit the real .env.

# --- Application -> database connection ---
# In Docker Compose the host is the SERVICE NAME of the db container, not localhost
DB_HOST=db
DB_PORT=3306
DB_NAME=parking_db
DB_USER=parking_user
DB_PASS=change_me_app_password

# --- MySQL container (official image variables) ---
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=parking_db
MYSQL_USER=parking_user
MYSQL_PASSWORD=change_me_app_password

# --- Host port you open in the browser ---
APP_PORT=8080
